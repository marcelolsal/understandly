{
  "name": "understandly",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "test": "npm run test:unit && npm run test:ui",
    "runtime:check": "node scripts/runtime.mjs check",
    "runtime:smoke": "node scripts/runtime.mjs smoke",
    "runtime:ask": "node scripts/runtime.mjs ask",
    "review:chapter": "node scripts/review-chapter.mjs",
    "review:docker": "node scripts/review-chapter.mjs --chapter ../work/understandly-data/courses/docker/chapters/01-modelo-mental.md --evidence ../work/understandly-data/courses/docker/source-evidence.json",
    "review:docker:auto": "npm run review:docker -- --auto --human",
    "dev": "astro dev",
    "build": "astro build",
    "start": "node scripts/serve.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "test:unit": "node --test tests/*.test.mjs",
    "test:ui": "node --import tsx --test tests/study-ui.spec.tsx",
    "test:http": "node --test tests/study-http.integration.mjs",
    "share": "node scripts/share.mjs"
  },
  "dependencies": {
    "@astrojs/node": "^11.1.9",
    "@astrojs/react": "^7.1.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.63.0",
    "marked": "^18.1.2",
    "mermaid": "^12.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sanitize-html": "^2.18.1",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/sanitize-html": "^2.16.2",
    "happy-dom": "^21.0.4",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
}
